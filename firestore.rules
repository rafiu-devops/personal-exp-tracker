rules_version = '2';

// Security rules for the Money Management PWA.
//
// Any signed-in user (email/password OR Google) may create and manage their
// OWN profile document and their OWN data. There is no admin account and no
// user can read or write anyone else's tree. Every user owns users/{uid}.
//
// All data lives under users/{uid}/** subcollections; the profile itself is
// the users/{uid} document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
